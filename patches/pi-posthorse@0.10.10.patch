new file mode 100644
--- /dev/null
+++ b/src/note-read.ts
@@ -0,0 +1,41 @@
+import { constants, type Stats } from "node:fs";
+import fs from "node:fs/promises";
+
+export const MAX_NOTE_READ_BYTES = 1024 * 1024;
+
+function unchanged(before: Stats, after: Stats): boolean {
+	return before.dev === after.dev && before.ino === after.ino &&
+		before.size === after.size && before.mtimeMs === after.mtimeMs &&
+		before.ctimeMs === after.ctimeMs && after.isFile();
+}
+
+/** One limited snapshot. Never reopen the path for binary detection or decoding. */
+export async function readNoteBytes(path: string, expected: Stats, signal?: AbortSignal): Promise<Buffer> {
+	signal?.throwIfAborted();
+	// Nonblocking open prevents a replacement FIFO from hanging before fstat rejects it.
+	const file = await fs.open(path, constants.O_RDONLY | constants.O_NONBLOCK);
+	try {
+		signal?.throwIfAborted();
+		const before = await file.stat();
+		if (!unchanged(expected, before)) throw new Error("The note changed before reading. Retry the read.");
+		if (before.size > MAX_NOTE_READ_BYTES) throw new Error("This note exceeds the 1 MiB read limit.");
+		const buffer = Buffer.alloc(MAX_NOTE_READ_BYTES + 1);
+		let length = 0;
+		while (length < buffer.length) {
+			signal?.throwIfAborted();
+			const { bytesRead } = await file.read(buffer, length, Math.min(64 * 1024, buffer.length - length), length);
+			signal?.throwIfAborted();
+			if (bytesRead === 0) break;
+			length += bytesRead;
+		}
+		if (length > MAX_NOTE_READ_BYTES) throw new Error("This note exceeds the 1 MiB read limit.");
+		const after = await file.stat();
+		const current = await fs.stat(path);
+		signal?.throwIfAborted();
+		if (length !== before.size || !unchanged(before, after) || !unchanged(after, current))
+			throw new Error("The note changed while reading. Retry the read.");
+		return buffer.subarray(0, length);
+	} finally {
+		await file.close();
+	}
+}
