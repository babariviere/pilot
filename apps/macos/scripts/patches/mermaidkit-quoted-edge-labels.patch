+    /// Mermaid draws quoted link labels (`-->|"text"|`, `-- "text" -->`) without their quotes.
+    static func unquotedLabel(_ raw: Substring) -> String {
+        let label = raw.trimmingCharacters(in: .whitespaces)
+        guard label.count >= 2, label.hasPrefix("\""), label.hasSuffix("\"") else { return String(raw) }
+        return String(label.dropFirst().dropLast())
+    }
