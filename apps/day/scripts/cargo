#!/usr/bin/env bash
# NSH's supported CARGO hook, for check/test and every generated host build.
set -euo pipefail
# shellcheck source=apps/day/scripts/build-env.sh
source "$(dirname "$0")/build-env.sh"
cargo_path="$(type -P cargo || true)"
if [[ ! -x "$cargo_path" || "$cargo_path" -ef "$0" ]]; then
	echo 'Day requires Cargo on PATH.' >&2
	exit 127
fi
export CARGO="$cargo_path"
exec "$cargo_path" "$@"
