{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"enabledManagers": ["npm", "cargo"],
	"dependencyDashboard": true,
	"minimumReleaseAge": "24 hours",
	"automerge": false,
	"prConcurrentLimit": 3,
	"packageRules": [
		{
			"description": "Batch routine npm runtime updates; review major upgrades separately",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "npm runtime dependencies",
			"groupSlug": "npm-runtime"
		},
		{
			"description": "Keep JavaScript tooling and type definitions out of runtime batches",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["minor", "patch"],
			"matchPackageNames": ["@biomejs/**", "@types/**", "@typescript/**", "tsx"],
			"groupName": "JavaScript tooling",
			"groupSlug": "js-tooling"
		},
		{
			"description": "Update OpenTelemetry packages together without mixing unrelated runtime changes",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["minor", "patch"],
			"matchPackageNames": ["@opentelemetry/**"],
			"groupName": "OpenTelemetry",
			"groupSlug": "opentelemetry"
		},
		{
			"description": "Batch routine crate updates across maintained workspaces and lockfiles",
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Rust dependencies",
			"groupSlug": "rust-dependencies"
		},
		{
			"description": "GPUI upgrades require coordinated source patches and native qualification",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["gpui-*"],
			"enabled": false
		},
		{
			"description": "ZIP admission mirrors zip 8.6.0 parser behavior; re-audit before upgrading",
			"matchManagers": ["cargo"],
			"matchFileNames": ["apps/desktop/updater/Cargo.toml"],
			"matchPackageNames": ["zip"],
			"enabled": false
		},
		{
			"description": "Day's NSH crates must match the installed, qualified NSH CLI release; upgrade them together by hand",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["nsh-*"],
			"enabled": false
		},
		{
			"description": "Track upstream embedding profiles with pnpm Git digest updates",
			"matchManagers": ["npm"],
			"matchPackageNames": ["babariviere/pi-extensions"],
			"overrideDatasource": "git-refs",
			"overridePackageName": "https://github.com/babariviere/pi-extensions.git",
			"versioning": "git",
			"followTag": "main",
			"pinDigests": true,
			"enabled": true
		},
		{
			"description": "Update Pi SDK dependencies and pnpm overrides together",
			"matchManagers": ["npm"],
			"matchPackageNames": ["@earendil-works/**"],
			"groupName": "Pi SDK",
			"groupSlug": "pi-sdk",
			"rangeStrategy": "pin",
			"separateMajorMinor": false
		},
		{
			"matchPackageNames": ["@gotgenes/pi-anthropic-auth"],
			"rangeStrategy": "pin"
		}
	],
	"skipArtifactsUpdate": false,
	"lockFileMaintenance": {
		"enabled": true
	},
	"statusCheckWhen": {
		"artifactError": "always"
	}
}
