{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"enabledManagers": ["npm", "cargo"],
	"dependencyDashboard": true,
	"minimumReleaseAge": "24 hours",
	"automerge": false,
	"prConcurrentLimit": 3,
	"packageRules": [
		{
			"description": "GPUI upgrades require coordinated source patches and native qualification",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["gpui-*"],
			"enabled": false
		},
		{
			"description": "ZIP admission mirrors zip 8.6.0 parser behavior; re-audit before upgrading",
			"matchManagers": ["cargo"],
			"matchFileNames": ["apps/desktop/updater/Cargo.toml"],
			"matchPackageNames": ["zip"],
			"enabled": false
		},
		{
			"description": "NSH comparison fixtures retain their qualified source and dependency baseline",
			"matchManagers": ["cargo"],
			"matchFileNames": ["experiments/nsh-chat/**"],
			"enabled": false
		},
		{
			"description": "Use npm Git digest updates and pnpm artifacts; enable after upstream main includes embedding exports",
			"matchManagers": ["npm"],
			"matchPackageNames": ["babariviere/pi-extensions"],
			"overrideDatasource": "git-refs",
			"overridePackageName": "https://github.com/babariviere/pi-extensions.git",
			"versioning": "git",
			"followTag": "main",
			"pinDigests": true,
			"enabled": false
		},
		{
			"description": "Update Pi SDK dependencies and pnpm overrides together",
			"matchManagers": ["npm"],
			"matchPackageNames": ["@earendil-works/**"],
			"groupName": "Pi SDK",
			"groupSlug": "pi-sdk",
			"rangeStrategy": "pin",
			"separateMajorMinor": false
		},
		{
			"matchPackageNames": ["@gotgenes/pi-anthropic-auth"],
			"rangeStrategy": "pin"
		}
	],
	"skipArtifactsUpdate": false,
	"statusCheckWhen": {
		"artifactError": "always"
	}
}
