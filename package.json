{
	"name": "pilot",
	"version": "1.25.2",
	"private": true,
	"description": "Background pi agents: durable sessions, a native macOS app, and triggers from GitHub, Slack and Linear.",
	"type": "module",
	"license": "MIT",
	"author": "babariviere",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev:daemon": "pnpm --filter @pilot/daemon dev",
		"start": "pnpm --filter @pilot/daemon start",
		"app:macos": "apps/macos/scripts/bundle.sh",
		"artifacts:browser": "pnpm --filter @pilot/artifacts exec playwright install chromium",
		"artifacts:libraries": "node packages/artifacts/scripts/build-libraries.ts",
		"typecheck": "tsgo -p tsconfig.json",
		"test": "node --import tsx --test --test-force-exit --test-timeout=${PILOT_TEST_TIMEOUT_MS:-120000} --test-concurrency=${PILOT_TEST_CONCURRENCY:-2} 'packages/*/src/**/*.test.ts'",
		"bench:workspace": "node scripts/bench/workspace.ts",
		"bench:reopen": "node scripts/bench/reopen.ts",
		"bench:daemon-reopen": "node scripts/bench/daemon-reopen.ts",
		"lint": "biome lint .",
		"fmt": "biome format --write .",
		"fmt:check": "biome format ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.0.0",
		"@typescript/native-preview": "latest",
		"tsx": "^4.23.15"
	}
}
