{
	"name": "pilot",
	"version": "1.83.0",
	"private": true,
	"description": "A native macOS app for background pi coding agents, with durable chats, isolated workspaces, and reviewable pull requests.",
	"type": "module",
	"license": "MIT",
	"author": "babariviere",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev:daemon": "pnpm --filter @pilot/daemon dev",
		"start": "pnpm --filter @pilot/daemon start",
		"app:macos": "apps/macos/scripts/bundle.sh",
		"artifacts:browser": "pnpm --filter @pilot/artifacts exec playwright install chromium",
		"artifacts:libraries": "node packages/artifacts/scripts/build-libraries.ts",
		"typecheck": "tsgo -p tsconfig.json",
		"test": "node scripts/test.ts",
		"bench:workspace": "node scripts/bench/workspace.ts",
		"bench:reopen": "node scripts/bench/reopen.ts",
		"bench:daemon-reopen": "node scripts/bench/daemon-reopen.ts",
		"lint": "biome lint .",
		"fmt": "biome format --write .",
		"fmt:check": "biome format .",
		"test:fast": "node scripts/test.ts --suite=fast",
		"test:integration": "node scripts/test.ts --suite=integration",
		"test:stress": "node scripts/test.ts --suite=stress",
		"test:timings": "node scripts/test.ts --timings"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^24.0.0",
		"@typescript/native-preview": "latest",
		"tsx": "^4.23.15"
	}
}
